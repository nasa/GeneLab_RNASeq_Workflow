// Config that specifies packaged conda yml files for each process
process {
    withName: 'GTF_TO_PRED' {
        // gtftogenepred 469 (08/27/2024), Kent utils 472 is not on Quay, no version reported
        container = "quay.io/biocontainers/ucsc-gtftogenepred:469--h9b8f530_0"
    }
    withName: 'PRED_TO_BED' {
        // genepredtobed 469 (08/27/2024), Kent utils 472 is not on Quay, no version reported
        container = "quay.io/biocontainers/ucsc-genepredtobed:469--h9b8f530_0"
    }

    withName: 'INFER_EXPERIMENT|GENEBODY_COVERAGE|INNER_DISTANCE|READ_DISTRIBUTION' {
        // rseqc 5.0.4 (10/03/2024), 2.52GB
        // Biocontainers mulled container w/ rseqc 5.0.4 and r-base 4.4.3, 1.89GB:
        //container = "quay.io/biocontainers/mulled-v2-c80ae8d0fe5685926c9bc673e400ff09a71844fd:a844c3f0409b9334406a2a449e92dcccfaea4b2e-0"
        container = "quay.io/biocontainers/rseqc:5.0.4--pyhdfd78af_1"
    }

    withName: 'SUBSAMPLE_GENOME|SORT_AND_INDEX_BAM|SAM_TO_BAM' {
        // samtools 1.21 (09/12/2024)
        // mulled bowtie2 2.5.4 + samtools 1.21:
        // container = "quay.io/biocontainers/mulled-v2-c742dccc9d8fabfcff2af0d8d6799dbc711366cf:7d8874158a9103084ff44dcf024a118242d67478-0"
        container = "quay.io/biocontainers/samtools:1.21--h50ea8bc_0"
    }
    withName: 'QUANTIFY_STAR_GENES|QUANTIFY_RSEM_GENES|DGE_DESEQ2|EXTEND_DGE_TABLE|QUANTIFY_FEATURECOUNTS_GENES|ANNOTATE_DGE_TABLE' {
        // gl-rnaseq 1.0.0, R libraries for workflow scripts
        container = "quay.io/nasa_genelab/gl-rnaseq:1.0.0"
    }

    withName: 'ERCC_ANALYSIS' {
        container = "quay.io/nasa_genelab/ercc:1.0.0"
    }

    withName: 'FASTQC|RAW_FASTQC|TRIMMED_FASTQC' {
        // fastqc 0.12.1 (03/01/2023)
        container = "quay.io/biocontainers/fastqc:0.12.1--hdfd78af_0"
    }

    withName: 'TRIMGALORE' {
        // Trim Galore 0.6.10 (02/02/2023), pigz is built into the image
        container = "quay.io/biocontainers/trim-galore:0.6.10--hdfd78af_0"
    }

    withName: 'BUILD_STAR_INDEX|ALIGN_STAR' {
        // STAR 2.7.11b (01/24/2024)
        container = "quay.io/biocontainers/star:2.7.11b--h43eeafb_1"
    }

    withName: 'BUILD_BOWTIE2_INDEX|ALIGN_BOWTIE2' {
        // Bowtie2 2.5.4 (12/10/2024)
        container = "quay.io/biocontainers/bowtie2:2.5.4--he96a11b_5"
    }

    withName: 'FEATURECOUNTS' {
        // featureCounts 2.0.8 (12/10/2024)
        container = "quay.io/biocontainers/subread:2.0.8--h577a1d6_0"
    }

    withName: 'BUILD_RSEM_INDEX|COUNT_ALIGNED' {
        // RSEM 1.3.3 (02/14/2020), prints its version as 1.31: https://github.com/deweylab/RSEM/issues/153
        container = "quay.io/biocontainers/rsem:1.3.3--pl526ha52163a_0"
    }

    withName: 'MULTIQC|GET_ACCESSIONS|FETCH_ISA|ISA_TO_RUNSHEET|GENERATE_MD5SUMS|SOFTWARE_VERSIONS|PARSE_QC_METRICS|REMOVE_RRNA_FEATURECOUNTS|UPDATE_ASSAY_TABLE|GENERATE_PROTOCOL|TRUNCATE_RUNSHEET|GET_OSDR_FILE_LIST|UPDATE_OSDR_RUNSHEET|REMOVE_RRNA_COUNTS_TABLE|COPY_READS|COPY_BAMS|COPY_GENOME_BAMS|COPY_GENES_RESULTS|COPY_COUNTS_TABLE|COPY_DGE_TABLE|COPY_REFERENCES|FETCH_READS|FETCH_BAM|FETCH_GENOME_BAM|FETCH_GENES_RESULTS|FETCH_TABLE|FETCH_COUNTS_TABLE|FETCH_DGE_TABLE|FETCH_ANNOTATIONS_TABLE|FETCH_ANNOTATIONS|DOWNLOAD_REFERENCES|DOWNLOAD_ERCC|SPLIT_ORGANISM_PART_RUNSHEETS|FILTER_UNALIGNABLE' {
        container = "quay.io/nasa_genelab/dp_tools:1.3.8-slim"
    }

    withLabel: 'VV' {
        container = "quay.io/nasa_genelab/dp_tools:1.3.8-slim"
    }

    withName: 'GET_MAX_READ_LENGTH|ASSESS_STRANDEDNESS|GET_GTF_FEATURES|PARSE_ANNOTATIONS_TABLE' {
        container = "quay.io/biocontainers/python:3.11"
    }
}
